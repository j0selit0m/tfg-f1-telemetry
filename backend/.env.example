# ==============================
# Variables de entorno del Backend
# ==============================

# Ruta preferida para la caché de FastF1 (típicamente HDD externo).
# Si la ruta no es accesible, se usará automáticamente FASTF1_CACHE_LOCAL_PATH.
FASTF1_CACHE_HDD_PATH=E:\TFG_F1_Cache

# Ruta de caché alternativa (local al proyecto, ignorada por Git).
FASTF1_CACHE_LOCAL_PATH=fastf1_cache_local

# Orígenes permitidos para CORS, separados por comas (sin espacios).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Gemini (Análisis con IA) ----
# API key gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_key_aqui
GEMINI_MODEL=gemini-2.5-flash